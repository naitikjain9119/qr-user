<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QR Generator – Naitik | User Panel</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<!-- Firebase SDKs -->
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>

<style>
:root {
  --ink: #0d0d0d;
  --paper: #f5f0e8;
  --cream: #ede8dc;
  --gold: #c9a84c;
  --gold-light: #e8c96e;
  --shadow: rgba(13,13,13,0.18);
  --red: #c0392b;
  --green: #27ae60;
  --purple: #8e44ad;
  --purple-light: #f5eefa;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--paper);
  color: var(--ink);
  min-height: 100vh;
  background-image:
    radial-gradient(circle at 15% 20%, rgba(201,168,76,0.08) 0%, transparent 50%),
    radial-gradient(circle at 85% 80%, rgba(176,48,48,0.06) 0%, transparent 50%);
}

/* ══ LOGIN PAGE ══ */
#login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
}
.login-box {
  background: #fff;
  border: 1.5px solid var(--cream);
  border-radius: 24px;
  padding: 44px 36px;
  width: 100%;
  max-width: 420px;
  box-shadow: 0 12px 50px var(--shadow);
  text-align: center;
}
.login-logo { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 900; color: var(--ink); margin-bottom: 6px; }
.login-logo span { color: var(--gold); }
.login-sub { font-size: 13px; color: #888; margin-bottom: 32px; }
.login-field { margin-bottom: 16px; text-align: left; }
.login-field label { display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: #888; margin-bottom: 7px; }
.login-field input {
  width: 100%; border: 1.5px solid #e0d6c8; border-radius: 12px;
  padding: 13px 14px; font-family: 'DM Sans', sans-serif; font-size: 15px;
  color: var(--ink); background: var(--paper); outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.login-field input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,168,76,0.15); background: #fff; }
.btn-login {
  width: 100%; padding: 15px; background: var(--ink); color: #fff;
  border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif;
  font-size: 15px; font-weight: 600; letter-spacing: 0.05em;
  cursor: pointer; margin-top: 8px; transition: background .2s;
}
.btn-login:hover { background: #2a2a2a; }
.login-error { color: var(--red); font-size: 13px; margin-top: 10px; display: none; font-weight: 500; }
.blocked-msg {
  background: #fdf0ef; border: 1.5px solid #f5c6c2; border-radius: 12px;
  color: var(--red); font-size: 14px; padding: 14px 16px;
  margin-top: 12px; display: none; font-weight: 500;
}

/* ══ MAIN APP ══ */
#main-app { display: none; }

/* Top nav bar */
.top-nav {
  background: var(--ink); color: #fff;
  padding: 0 20px; display: flex; align-items: center; justify-content: space-between;
  height: 56px; position: sticky; top: 0; z-index: 100;
}
.nav-brand { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 900; }
.nav-brand span { color: var(--gold); }
.nav-right { display: flex; align-items: center; gap: 12px; }
.nav-user-badge { font-size: 13px; color: rgba(255,255,255,0.7); }

/* Token display block */
.token-display-block {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(142,68,173,0.22);
  border: 1.5px solid rgba(142,68,173,0.4);
  border-radius: 10px;
  padding: 5px 12px;
  font-size: 13px;
  font-weight: 700;
  color: #d7aff0;
  letter-spacing: 0.03em;
  cursor: default;
}
.token-display-block .token-icon { font-size: 14px; }
.token-display-block .token-num { color: #fff; font-size: 15px; }

.btn-logout {
  background: rgba(255,255,255,0.12); border: 1.5px solid rgba(255,255,255,0.2);
  border-radius: 8px; color: #fff; font-family: 'DM Sans', sans-serif;
  font-size: 13px; font-weight: 500; padding: 6px 14px;
  cursor: pointer; transition: background .2s;
}
.btn-logout:hover { background: rgba(255,255,255,0.22); }

/* Tab bar */
.tab-bar {
  background: #fff; border-bottom: 1.5px solid var(--cream);
  display: flex; padding: 0 20px; gap: 4px;
}
.tab-btn {
  padding: 14px 20px; font-family: 'DM Sans', sans-serif; font-size: 14px;
  font-weight: 600; color: #888; background: none; border: none;
  border-bottom: 3px solid transparent; cursor: pointer;
  transition: color .2s, border-color .2s; display: flex; align-items: center; gap: 7px;
}
.tab-btn.active { color: var(--ink); border-bottom-color: var(--gold); }
.tab-btn:hover:not(.active) { color: #555; }

/* Content area */
.content-area { padding: 32px 16px 80px; display: flex; flex-direction: column; align-items: center; }

/* ══ QR GENERATOR ══ */
header { text-align: center; margin-bottom: 40px; }
header .eyebrow { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 8px; }
header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 6vw, 3.2rem); font-weight: 900; line-height: 1.1; color: var(--ink); }
header h1 span { color: var(--gold); }
header p.sub { margin-top: 10px; font-size: 14px; color: #666; font-weight: 300; }

.card { background: #fff; border: 1.5px solid var(--cream); border-radius: 20px; padding: 36px 32px 32px; width: 100%; max-width: 520px; box-shadow: 0 8px 40px var(--shadow); }

label { display: block; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: #888; margin-bottom: 8px; }

#numbers-container { margin-bottom: 16px; }
.number-entry {
  background: var(--paper); border: 1.5px solid var(--cream);
  border-radius: 14px; padding: 16px; margin-bottom: 12px;
  position: relative; transition: border-color .2s;
}
.number-entry:focus-within { border-color: var(--gold); }
.entry-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.entry-num { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; color: var(--gold); }
.btn-remove { background: none; border: 1.5px solid #e0d6c8; border-radius: 8px; color: #aaa; font-size: 13px; cursor: pointer; padding: 3px 10px; font-family: 'DM Sans', sans-serif; transition: border-color .2s, color .2s; }
.btn-remove:hover { border-color: var(--red); color: var(--red); }

.type-select {
  width: 100%; border: 1.5px solid #e0d6c8; border-radius: 10px;
  padding: 10px 12px; font-family: 'DM Sans', sans-serif; font-size: 14px;
  font-weight: 600; color: var(--ink); background: #fff; outline: none;
  margin-bottom: 10px; cursor: pointer; transition: border-color .2s;
}
.type-select:focus { border-color: var(--gold); }

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
@media (max-width: 440px) { .field-row { grid-template-columns: 1fr; } }

.input-wrap { position: relative; }
.input-wrap .prefix { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 14px; color: var(--gold); pointer-events: none; }
.input-wrap input {
  width: 100%; border: 1.5px solid #e0d6c8; border-radius: 10px;
  padding: 11px 12px 11px 34px; font-family: 'DM Sans', sans-serif;
  font-size: 15px; color: var(--ink); background: #fff; outline: none;
  transition: border-color .2s, box-shadow .2s; -webkit-appearance: none;
}
.input-wrap input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,168,76,0.15); }

.details-wrap { margin-top: 16px; }
textarea#detail {
  width: 100%; border: 1.5px solid var(--cream); border-radius: 12px;
  padding: 13px 14px; font-family: 'DM Sans', sans-serif; font-size: 15px;
  color: var(--ink); background: var(--paper); resize: vertical; min-height: 76px;
  line-height: 1.5; outline: none; transition: border-color .2s, box-shadow .2s; -webkit-appearance: none;
}
textarea#detail:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,168,76,0.15); background: #fff; }

.btn-add-number {
  width: 100%; padding: 12px; background: transparent; color: var(--gold);
  border: 1.5px dashed var(--gold-light); border-radius: 12px;
  font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600;
  cursor: pointer; transition: background .2s, border-color .2s;
  margin-bottom: 16px; letter-spacing: 0.04em;
}
.btn-add-number:hover { background: rgba(201,168,76,0.08); border-color: var(--gold); }

/* Token warning banner */
.token-warning {
  background: #fdf0ef; border: 1.5px solid #f5c6c2; border-radius: 12px;
  padding: 14px 16px; margin-bottom: 16px; text-align: center;
  color: var(--red); font-size: 14px; font-weight: 600; display: none;
}
.token-info-bar {
  background: var(--purple-light); border: 1.5px solid rgba(142,68,173,0.25); border-radius: 12px;
  padding: 10px 16px; margin-bottom: 16px; text-align: center;
  color: var(--purple); font-size: 13px; font-weight: 600; display: none;
}

.btn-generate {
  width: 100%; padding: 15px; background: var(--ink); color: #fff;
  border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif;
  font-size: 15px; font-weight: 600; letter-spacing: 0.05em;
  cursor: pointer; transition: background .2s, transform .1s; margin-top: 4px;
}
.btn-generate:hover:not(:disabled) { background: #2a2a2a; }
.btn-generate:active:not(:disabled) { transform: scale(0.98); }
.btn-generate:disabled { opacity: 0.5; cursor: not-allowed; }

#result-section { display: none; width: 100%; max-width: 520px; margin-top: 32px; animation: fadeUp .4s ease both; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

#print-card { background: #fff; border: 1.5px solid var(--cream); border-radius: 20px; padding: 28px 28px 24px; box-shadow: 0 8px 40px var(--shadow); text-align: center; }
.print-header { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1.5px solid var(--cream); }
.print-brand { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 900; color: var(--ink); line-height: 1.2; }
.print-brand span { color: var(--gold); }
.print-sub { font-size: 13px; color: #888; margin-top: 4px; letter-spacing: 0.04em; }
.detail-block { background: var(--paper); border-radius: 12px; padding: 12px 16px; font-size: 14px; color: #444; line-height: 1.6; text-align: left; margin-bottom: 20px; border-left: 3px solid var(--gold); }
#qr-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-bottom: 20px; }
.qr-item { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.qr-box { display: flex; justify-content: center; align-items: center; padding: 14px; background: var(--paper); border-radius: 14px; }
.qr-box canvas, .qr-box img { border-radius: 6px; display: block; }
.qr-name { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; color: var(--ink); letter-spacing: 0.02em; }
.phone-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--ink); color: #fff; border-radius: 999px; padding: 6px 14px; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; max-width: 240px; word-break: break-all; }
.print-footer { margin-top: 4px; padding-top: 14px; border-top: 1.5px solid var(--cream); font-size: 13px; color: #aaa; letter-spacing: 0.1em; font-style: italic; }
.print-footer strong { color: var(--gold); font-style: normal; font-size: 15px; }

.action-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
.btn-action { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 10px; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: transform .1s, opacity .2s; }
.btn-action:active { transform: scale(0.97); }
.btn-action:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
.btn-download { background: var(--ink); color: #fff; box-shadow: 0 4px 14px rgba(13,13,13,0.2); }
.btn-download:hover:not(:disabled) { background: #2a2a2a; }
.btn-share { background: var(--gold); color: #fff; box-shadow: 0 4px 14px rgba(201,168,76,0.35); }
.btn-share:hover:not(:disabled) { background: var(--gold-light); color: var(--ink); }
.spin { width: 16px; height: 16px; border: 2.5px solid rgba(255,255,255,0.35); border-top-color: #fff; border-radius: 50%; animation: rot .6s linear infinite; display: none; }
.btn-share .spin { border-top-color: var(--ink); }
.busy .spin { display: inline-block; }
.busy .ico { display: none; }
@keyframes rot { to { transform: rotate(360deg); } }

/* ══ HISTORY PAGE ══ */
#history-page { display: none; width: 100%; max-width: 640px; }
.history-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.history-header h2 { font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 900; }
.history-count { background: var(--gold); color: #fff; border-radius: 999px; font-size: 12px; font-weight: 700; padding: 3px 10px; }
.history-empty { text-align: center; padding: 60px 20px; color: #aaa; }
.history-empty div { font-size: 48px; margin-bottom: 12px; }
.history-empty p { font-size: 14px; }
.history-item {
  background: #fff; border: 1.5px solid var(--cream); border-radius: 16px;
  padding: 18px 20px; margin-bottom: 12px; box-shadow: 0 2px 12px rgba(13,13,13,0.06);
  animation: fadeUp .3s ease both;
}
.history-item-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
.history-item-left { flex: 1; }
.history-item-time { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 4px; }
.history-item-nums { font-size: 15px; font-weight: 600; color: var(--ink); }
.history-item-detail { font-size: 13px; color: #777; margin-top: 6px; line-height: 1.5; background: var(--paper); border-radius: 8px; padding: 8px 10px; border-left: 2px solid var(--gold); }
.history-entries { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.history-entry-chip { background: var(--ink); color: #fff; border-radius: 8px; padding: 5px 12px; font-size: 13px; font-weight: 500; }
.history-entry-chip span { color: var(--gold-light); margin-right: 5px; }

/* Toast */
.toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(80px); background: var(--ink); color: #fff; padding: 12px 24px; border-radius: 999px; font-size: 14px; font-weight: 500; transition: transform .3s ease; z-index: 9999; white-space: nowrap; max-width: 92vw; text-align: center; }
.toast.show { transform: translateX(-50%) translateY(0); }

@media (max-width: 400px) { .card { padding: 24px 18px; } .action-row { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<!-- ══ LOGIN PAGE ══ -->
<div id="login-page">
  <div class="login-box">
    <div class="login-logo">Dial <span>QR</span></div>
    <div class="login-sub">User Panel – Please login to continue</div>
    <div class="login-field">
      <label>Username</label>
      <input type="text" id="login-username" placeholder="Enter your username" autocomplete="username">
    </div>
    <div class="login-field">
      <label>Password</label>
      <input type="password" id="login-password" placeholder="Enter your password" autocomplete="current-password"
        onkeydown="if(event.key==='Enter') doUserLogin()">
    </div>
    <button class="btn-login" onclick="doUserLogin()">🔐 Login</button>
    <div class="login-error" id="login-error">❌ Invalid username or password</div>
    <div class="blocked-msg" id="blocked-msg">🚫 Your account has been temporarily blocked by the host. Please contact the host.</div>
  </div>
</div>

<!-- ══ MAIN APP ══ -->
<div id="main-app">
  <!-- Top Nav -->
  <div class="top-nav">
    <div class="nav-brand">Dial <span>QR</span></div>
    <div class="nav-right">
      <!-- Token display block (top-right) -->
      <div class="token-display-block" id="token-display" title="QR generation tokens remaining">
        <span class="token-icon">🎟️</span>
        <span id="token-display-num" class="token-num">0</span>
        <span style="font-size:11px;opacity:0.75;">tokens</span>
      </div>
      <div class="nav-user-badge" id="nav-username-display">User</div>
      <button class="btn-logout" onclick="doLogout()">Logout</button>
    </div>
  </div>

  <!-- Tab Bar -->
  <div class="tab-bar">
    <button class="tab-btn active" id="tab-generator" onclick="switchTab('generator')">
      ⚡ QR Generator
    </button>
    <button class="tab-btn" id="tab-history" onclick="switchTab('history')">
      📋 History
    </button>
  </div>

  <!-- Content -->
  <div class="content-area">

    <!-- ── QR Generator Tab ── -->
    <div id="generator-page" style="width:100%;display:flex;flex-direction:column;align-items:center;">
      <header>
        <div class="eyebrow">QR Generator</div>
        <h1>Dial <span>QR</span></h1>
        <p class="sub">Multiple links & numbers → one card → direct scan</p>
      </header>

      <div class="card">
        <!-- Token warning / info banners -->
        <div class="token-warning" id="token-warning">
          🚫 आपके पास कोई token नहीं है। QR generate करने के लिए host से tokens लें।
        </div>
        <div class="token-info-bar" id="token-info-bar">
          🎟️ इस generation के बाद <span id="token-after-count">0</span> token(s) बचेंगे।
        </div>

        <div id="numbers-container"></div>
        <button class="btn-add-number" onclick="addEntry()">＋ &nbsp;Add Another Entry</button>
        <div class="details-wrap">
          <label for="detail" style="margin-bottom:8px">Details <span style="font-weight:300;text-transform:none;letter-spacing:0">(optional – shown on card)</span></label>
          <textarea id="detail" placeholder="Add a shared note or description…"></textarea>
        </div>
        <button class="btn-generate" id="btn-generate" onclick="generateQR()" style="margin-top:18px">⚡ Generate QR Code</button>
      </div>

      <div id="result-section">
        <div id="print-card">
          <div class="print-header">
            <div class="print-brand">Naitik <span>Rakesh Kumar Jain</span></div>
            <div class="print-sub">Salumber, Rajasthan</div>
          </div>
          <div class="detail-block" id="detail-display" style="display:none"></div>
          <div id="qr-grid"></div>
          <div class="print-footer"><strong>Thanks 🙏</strong><br>Scan to open or connect directly</div>
        </div>
        <div class="action-row">
          <button class="btn-action btn-download" id="btn-dl" onclick="doDownload()">
            <span class="ico">⬇️ &nbsp;Download</span>
            <span class="spin"></span>
          </button>
          <button class="btn-action btn-share" id="btn-sh" onclick="doShare()">
            <span class="ico">📤 &nbsp;Share</span>
            <span class="spin"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- ── History Tab ── -->
    <div id="history-page">
      <div class="history-header">
        <h2>📋 My History</h2>
        <span class="history-count" id="history-count">0</span>
      </div>
      <div id="history-list"></div>
    </div>

  </div><!-- content-area -->
</div><!-- main-app -->

<div class="toast" id="toast"></div>

<script>
/* ════════════════════════════════
   FIREBASE INITIALIZATION & DB SETUP
════════════════════════════════ */
const firebaseConfig = {
  apiKey: "AIzaSyDgYyQqSsRae7ax4-9quU_FLsMVlU6UDEI",
  authDomain: "qr-genrate-c2d3d.firebaseapp.com",
  databaseURL: "https://qr-genrate-c2d3d-default-rtdb.firebaseio.com",
  projectId: "qr-genrate-c2d3d",
  storageBucket: "qr-genrate-c2d3d.firebasestorage.app",
  messagingSenderId: "147721476154",
  appId: "1:147721476154:web:faee33b6a2374d29f5fd03"
};

firebase.initializeApp(firebaseConfig);
const db = firebase.database();

let dbUsers = {};
let dbBlocked = [];
let dbTokens = {};
let dbHistory = {};

// Sync Firebase realtime data with local cache
db.ref('qr_users').on('value', snapshot => {
  dbUsers = snapshot.val() || {};
});

db.ref('qr_blocked').on('value', snapshot => {
  const val = snapshot.val();
  if (Array.isArray(val)) dbBlocked = val;
  else if (val && typeof val === 'object') dbBlocked = Object.values(val);
  else dbBlocked = [];
});

db.ref('qr_tokens').on('value', snapshot => {
  dbTokens = snapshot.val() || {};
  if (currentUser) updateTokenDisplay();
});

db.ref('qr_history').on('value', snapshot => {
  dbHistory = snapshot.val() || {};
  if (currentUser && document.getElementById('history-page').style.display === 'block') {
    renderHistory();
  }
});

/* ════════════════════════════════
   TYPE CONFIGURATIONS
════════════════════════════════ */
const TYPE_CONFIG = {
  phone: {
    icon: '📞',
    label: 'Phone Call',
    placeholder: 'e.g. 9876543210',
    formatQr: (val) => 'tel:' + val.replace(/[^\d+]/g, ''),
    formatBadge: (val) => val,
    validate: (val) => /^\+?[\d\s\-().]{7,15}$/.test(val.trim())
  },
  whatsapp: {
    icon: '💬',
    label: 'WhatsApp',
    placeholder: 'e.g. 919876543210 (with country code)',
    formatQr: (val) => 'https://wa.me/' + val.replace(/[^\d]/g, ''),
    formatBadge: (val) => 'WA: ' + val,
    validate: (val) => val.replace(/[^\d]/g, '').length >= 7
  },
  map: {
    icon: '📍',
    label: 'Google Maps Location',
    placeholder: 'Google Maps Link or Location / Address',
    formatQr: (val) => {
      let trimmed = val.trim();
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
      return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(trimmed);
    },
    formatBadge: (val) => 'Google Map Location',
    validate: (val) => val.trim().length > 2
  },
  youtube: {
    icon: '▶️',
    label: 'YouTube Channel/Video',
    placeholder: 'YouTube Channel Link or Video URL',
    formatQr: (val) => {
      let trimmed = val.trim();
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
      if (trimmed.startsWith('@')) return 'https://youtube.com/' + trimmed;
      return 'https://youtube.com/results?search_query=' + encodeURIComponent(trimmed);
    },
    formatBadge: (val) => 'YouTube',
    validate: (val) => val.trim().length > 1
  },
  email: {
    icon: '✉️',
    label: 'Email Address',
    placeholder: 'e.g. example@gmail.com',
    formatQr: (val) => {
      let trimmed = val.trim();
      return trimmed.startsWith('mailto:') ? trimmed : 'mailto:' + trimmed;
    },
    formatBadge: (val) => val.replace('mailto:', ''),
    validate: (val) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val.trim().replace('mailto:', ''))
  },
  instagram: {
    icon: '📷',
    label: 'Instagram Profile',
    placeholder: 'Instagram Profile Link or Username',
    formatQr: (val) => {
      let trimmed = val.trim();
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
      return 'https://instagram.com/' + trimmed.replace('@', '');
    },
    formatBadge: (val) => 'Insta: ' + (val.includes('/') ? 'Profile' : val.replace('@', '@')),
    validate: (val) => val.trim().length > 1
  },
  facebook: {
    icon: '👤',
    label: 'Facebook Page/ID',
    placeholder: 'Facebook Link or Profile ID',
    formatQr: (val) => {
      let trimmed = val.trim();
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
      return 'https://facebook.com/' + trimmed;
    },
    formatBadge: (val) => 'Facebook',
    validate: (val) => val.trim().length > 1
  },
  telegram: {
    icon: '✈️',
    label: 'Telegram Channel/ID',
    placeholder: 'Telegram Link or Username (e.g. t.me/username)',
    formatQr: (val) => {
      let trimmed = val.trim();
      if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;
      return 'https://t.me/' + trimmed.replace('@', '');
    },
    formatBadge: (val) => 'Telegram: ' + val.replace('@', '@'),
    validate: (val) => val.trim().length > 1
  },
  url: {
    icon: '🌐',
    label: 'Website / Any URL',
    placeholder: 'https://example.com or any URL link',
    formatQr: (val) => {
      let trimmed = val.trim();
      if (!/^https?:\/\//i.test(trimmed)) {
        return 'https://' + trimmed;
      }
      return trimmed;
    },
    formatBadge: (val) => {
      let clean = val.trim().replace(/^https?:\/\//i, '');
      return clean.length > 22 ? clean.substring(0, 20) + '…' : clean;
    },
    validate: (val) => val.trim().length > 3
  }
};

/* ════════════════════════════════
   DATA HELPERS (Firebase sync)
════════════════════════════════ */
function getUsers() {
  return dbUsers;
}
function getBlockedUsers() {
  return dbBlocked;
}
function getHistory(username) {
  const h = dbHistory[username];
  if (!h) return [];
  if (Array.isArray(h)) return h;
  if (typeof h === 'object') return Object.values(h);
  return [];
}
function saveHistory(username, arr) {
  db.ref('qr_history/' + username).set(arr);
}

/* ── Token helpers ── */
function getMyTokens() {
  if (!currentUser) return 0;
  return typeof dbTokens[currentUser] === 'number' ? dbTokens[currentUser] : 0;
}

function consumeOneToken() {
  if (!currentUser) return false;
  const current = typeof dbTokens[currentUser] === 'number' ? dbTokens[currentUser] : 0;
  if (current <= 0) return false;
  const updated = current - 1;
  dbTokens[currentUser] = updated;
  db.ref('qr_tokens/' + currentUser).set(updated);
  return true;
}

function updateTokenDisplay() {
  const t = getMyTokens();
  document.getElementById('token-display-num').textContent = t;

  const warningEl = document.getElementById('token-warning');
  const infoEl = document.getElementById('token-info-bar');
  const generateBtn = document.getElementById('btn-generate');

  if (t <= 0) {
    warningEl.style.display = 'block';
    infoEl.style.display = 'none';
    generateBtn.disabled = true;
  } else {
    warningEl.style.display = 'none';
    infoEl.style.display = 'block';
    document.getElementById('token-after-count').textContent = t - 1;
    generateBtn.disabled = false;
  }
}

/* ════════════════════════════════
   AUTH
════════════════════════════════ */
let currentUser = null;

async function doUserLogin() {
  const username = document.getElementById('login-username').value.trim();
  const password = document.getElementById('login-password').value;

  document.getElementById('login-error').style.display = 'none';
  document.getElementById('blocked-msg').style.display = 'none';

  if (!username || !password) {
    document.getElementById('login-error').style.display = 'block';
    document.getElementById('login-error').textContent = '⚠️ Please enter username and password';
    return;
  }

  try {
    const blockedSnap = await db.ref('qr_blocked').once('value');
    const blockedVal = blockedSnap.val();
    const blocked = Array.isArray(blockedVal) ? blockedVal : (blockedVal ? Object.values(blockedVal) : []);

    if (blocked.includes(username)) {
      document.getElementById('blocked-msg').style.display = 'block';
      return;
    }

    const userSnap = await db.ref('qr_users/' + username).once('value');
    const userData = userSnap.val();

    if (!userData || userData.password !== password) {
      document.getElementById('login-error').style.display = 'block';
      document.getElementById('login-error').textContent = '❌ Invalid username or password';
      return;
    }

    // Login success
    currentUser = username;
    sessionStorage.setItem('qr_session_user', username);
    document.getElementById('login-page').style.display = 'none';
    document.getElementById('main-app').style.display = 'block';
    document.getElementById('nav-username-display').textContent = username;
    updateTokenDisplay();
    addEntry();
    startBlockWatcher();
    toast('✅ Welcome, ' + username + '!');
  } catch(e) {
    document.getElementById('login-error').style.display = 'block';
    document.getElementById('login-error').textContent = '❌ Connection error. Try again.';
  }
}

function doLogout() {
  if (blockWatcherInterval) { clearInterval(blockWatcherInterval); blockWatcherInterval = null; }
  currentUser = null;
  sessionStorage.removeItem('qr_session_user');
  document.getElementById('main-app').style.display = 'none';
  document.getElementById('login-page').style.display = 'flex';
  document.getElementById('login-username').value = '';
  document.getElementById('login-password').value = '';
  document.getElementById('login-error').style.display = 'none';
  document.getElementById('blocked-msg').style.display = 'none';
  document.getElementById('numbers-container').innerHTML = '';
  document.getElementById('result-section').style.display = 'none';
  entryCount = 0;
  toast('👋 Logged out');
}

window.addEventListener('DOMContentLoaded', () => {
  const saved = sessionStorage.getItem('qr_session_user');
  if (saved) {
    db.ref('qr_blocked').once('value').then(blockedSnap => {
      const blockedVal = blockedSnap.val();
      const blocked = Array.isArray(blockedVal) ? blockedVal : (blockedVal ? Object.values(blockedVal) : []);
      if (blocked.includes(saved)) {
        sessionStorage.removeItem('qr_session_user');
        return;
      }
      db.ref('qr_users/' + saved).once('value').then(userSnap => {
        if (userSnap.exists()) {
          currentUser = saved;
          document.getElementById('login-page').style.display = 'none';
          document.getElementById('main-app').style.display = 'block';
          document.getElementById('nav-username-display').textContent = saved;
          updateTokenDisplay();
          addEntry();
        }
      });
    });
  }
  startBlockWatcher();
});

/* ════════════════════════════════
   REAL-TIME BLOCK WATCHER
════════════════════════════════ */
let blockWatcherInterval = null;

function startBlockWatcher() {
  if (blockWatcherInterval) clearInterval(blockWatcherInterval);
  blockWatcherInterval = setInterval(() => {
    if (!currentUser) return;
    const blocked = getBlockedUsers();
    if (blocked.includes(currentUser)) {
      clearInterval(blockWatcherInterval);
      blockWatcherInterval = null;
      forceBlockLogout();
    }
  }, 2000);
}

function forceBlockLogout() {
  currentUser = null;
  sessionStorage.removeItem('qr_session_user');

  // Reset app UI
  document.getElementById('main-app').style.display = 'none';
  document.getElementById('numbers-container').innerHTML = '';
  document.getElementById('result-section').style.display = 'none';
  entryCount = 0;

  // Show login page with blocked message
  document.getElementById('login-page').style.display = 'flex';
  document.getElementById('login-username').value = '';
  document.getElementById('login-password').value = '';
  document.getElementById('login-error').style.display = 'none';
  document.getElementById('blocked-msg').style.display = 'block';
}

/* ════════════════════════════════
   TAB SWITCHING
════════════════════════════════ */
function switchTab(tab) {
  document.getElementById('generator-page').style.display = tab === 'generator' ? 'flex' : 'none';
  document.getElementById('history-page').style.display = tab === 'history' ? 'block' : 'none';
  document.getElementById('tab-generator').classList.toggle('active', tab === 'generator');
  document.getElementById('tab-history').classList.toggle('active', tab === 'history');
  if (tab === 'history') renderHistory();
  if (tab === 'generator') updateTokenDisplay();
}

/* ════════════════════════════════
   HISTORY
════════════════════════════════ */
function renderHistory() {
  if (!currentUser) return;
  const history = getHistory(currentUser);
  const container = document.getElementById('history-list');
  document.getElementById('history-count').textContent = history.length;

  if (history.length === 0) {
    container.innerHTML = `
      <div class="history-empty">
        <div>📭</div>
        <p>No history yet. Generate a QR code to see it here.</p>
      </div>`;
    return;
  }

  container.innerHTML = '';
  [...history].reverse().forEach(item => {
    const div = document.createElement('div');
    div.className = 'history-item';
    const chips = (item.entries || []).map(e => {
      const icon = e.icon || '📱';
      const label = e.badgeText || e.rawVal || e.phone || '';
      return `<div class="history-entry-chip"><span>${icon} ${e.name ? e.name + ' –' : ''}</span>${label}</div>`;
    }).join('');

    div.innerHTML = `
      <div class="history-item-top">
        <div class="history-item-left">
          <div class="history-item-time">${new Date(item.time).toLocaleString('hi-IN')}</div>
          <div class="history-item-nums">${(item.entries || []).length} Entry(s) Generated</div>
        </div>
      </div>
      <div class="history-entries">${chips}</div>
      ${item.detail ? `<div class="history-item-detail">📝 ${item.detail}</div>` : ''}
    `;
    container.appendChild(div);
  });
}

function addToHistory(entries, detail) {
  if (!currentUser) return;
  const history = getHistory(currentUser);
  history.push({ time: new Date().toISOString(), entries: entries, detail: detail });
  saveHistory(currentUser, history);
  addHostNotification(currentUser, entries, detail);
}

function addHostNotification(username, entries, detail) {
  try {
    const newNotif = {
      id: Date.now() + Math.random(),
      time: new Date().toISOString(),
      user: username,
      entries: entries,
      detail: detail,
      read: false
    };
    db.ref('qr_host_notifications').push(newNotif);
  } catch(e) {}
}

/* ════════════════════════════════
   ENTRY MANAGEMENT
════════════════════════════════ */
let entryCount = 0;

function addEntry() {
  entryCount++;
  const id = entryCount;
  const container = document.getElementById('numbers-container');
  const div = document.createElement('div');
  div.className = 'number-entry';
  div.id = 'entry-' + id;
  div.innerHTML = `
    <div class="entry-header">
      <span class="entry-num">Entry ${id}</span>
      ${id > 1 ? `<button class="btn-remove" onclick="removeEntry(${id})">✕ Remove</button>` : ''}
    </div>
    <select id="type-${id}" class="type-select" onchange="onTypeChange(${id})">
      <option value="phone">📞 Phone Call</option>
      <option value="whatsapp">💬 WhatsApp number</option>
      <option value="map">📍  Maps Location</option>
      <option value="youtube">▶️ YouTubel </option>
      <option value="email">✉️ Email Address</option>
      <option value="instagram">📷 Instagram Profile</option>
      <option value="facebook">👤 Facebook Page/ID</option>
      <option value="telegram">✈️ Telegram Channel/ID</option>
      <option value="url">🌐 Any Website / URL</option>
    </select>
    <div class="field-row">
      <div class="input-wrap">
        <span class="prefix" id="prefix-${id}">📞</span>
        <input type="text" id="val-${id}" placeholder="e.g. 9876543210"
          onkeydown="if(event.key==='Enter') generateQR()">
      </div>
      <div class="input-wrap">
        <span class="prefix">🏷️</span>
        <input type="text" id="name-${id}" placeholder="Title / Name (optional)" maxlength="30"
          onkeydown="if(event.key==='Enter') generateQR()">
      </div>
    </div>
  `;
  container.appendChild(div);
  document.getElementById('val-' + id).focus();
  updateEntryLabels();
}

function onTypeChange(id) {
  const type = document.getElementById('type-' + id).value;
  const cfg = TYPE_CONFIG[type] || TYPE_CONFIG['phone'];
  document.getElementById('prefix-' + id).textContent = cfg.icon;
  document.getElementById('val-' + id).placeholder = cfg.placeholder;
}

function removeEntry(id) {
  const el = document.getElementById('entry-' + id);
  if (el) el.remove();
  updateEntryLabels();
}

function updateEntryLabels() {
  const allEntries = document.querySelectorAll('.number-entry');
  allEntries.forEach((el, i) => {
    const label = el.querySelector('.entry-num');
    if (label) label.textContent = 'Entry ' + (i + 1);
  });
}

/* ════════════════════════════════
   GENERATE QR (with token check)
════════════════════════════════ */
let capturedPhones = [];

function generateQR() {
  // Token check
  const tokens = getMyTokens();
  if (tokens <= 0) {
    toast('🚫 No tokens left! Host se tokens mangwao.');
    updateTokenDisplay();
    return;
  }

  const allEntries = document.querySelectorAll('.number-entry');
  const data = [];

  for (const el of allEntries) {
    const id = el.id.replace('entry-', '');
    const typeSelect = document.getElementById('type-' + id);
    const valInput   = document.getElementById('val-' + id);
    const nameInput  = document.getElementById('name-' + id);

    const type   = typeSelect ? typeSelect.value : 'phone';
    const rawVal = valInput ? valInput.value.trim() : '';
    const name   = nameInput ? nameInput.value.trim() : '';

    if (rawVal) {
      const cfg = TYPE_CONFIG[type] || TYPE_CONFIG['phone'];
      if (!cfg.validate(rawVal)) {
        toast('⚠️ Invalid ' + cfg.label + ' detail: ' + rawVal);
        return;
      }
      const qrText = cfg.formatQr(rawVal);
      const badgeText = cfg.formatBadge(rawVal);
      data.push({ type, rawVal, name, qrText, badgeText, icon: cfg.icon });
    }
  }

  if (data.length === 0) { toast('⚠️ Kum se kum ek detail daalo'); return; }

  // Consume one token
  const consumed = consumeOneToken();
  if (!consumed) {
    toast('🚫 Token consume nahi ho saka. Dobara try karo.');
    updateTokenDisplay();
    return;
  }

  const detail = document.getElementById('detail').value.trim();
  capturedPhones = data.map(d => d.badgeText || d.rawVal);

  const grid = document.getElementById('qr-grid');
  grid.innerHTML = '';
  const qrSize = data.length === 1 ? 220 : 160;

  data.forEach(({ icon, qrText, name, badgeText }) => {
    const item = document.createElement('div');
    item.className = 'qr-item';
    const box = document.createElement('div');
    box.className = 'qr-box';
    const qrEl = document.createElement('div');
    box.appendChild(qrEl);

    new QRCode(qrEl, {
      text: qrText,
      width: qrSize, height: qrSize,
      colorDark: '#0d0d0d', colorLight: '#f5f0e8',
      correctLevel: QRCode.CorrectLevel.H
    });

    const nameEl = document.createElement('div');
    nameEl.className = 'qr-name';
    nameEl.textContent = name || '';

    const badge = document.createElement('div');
    badge.className = 'phone-badge';
    badge.innerHTML = `<span>${icon}</span> <span>${badgeText}</span>`;

    item.appendChild(box);
    if (name) item.appendChild(nameEl);
    item.appendChild(badge);
    grid.appendChild(item);
  });

  const det = document.getElementById('detail-display');
  if (detail) { det.textContent = detail; det.style.display = 'block'; }
  else         { det.style.display = 'none'; }

  const rs = document.getElementById('result-section');
  rs.style.display = 'block';
  setTimeout(() => rs.scrollIntoView({ behavior: 'smooth', block: 'start' }), 60);
  toast('✅ QR Code' + (data.length > 1 ? 's' : '') + ' ready! 1 token use hua.');

  // Update token display after consumption
  updateTokenDisplay();

  // Save to history
  addToHistory(data, detail);
}

/* ════════════════════════════════
   CAPTURE CARD
════════════════════════════════ */
async function captureCard() {
  await new Promise(r => setTimeout(r, 300));
  const el = document.getElementById('print-card');
  const canvas = await html2canvas(el, {
    scale: 3, backgroundColor: '#ffffff', useCORS: true,
    allowTaint: true, logging: false,
    onclone: (doc) => {
      const clone = doc.getElementById('print-card');
      if (clone) clone.style.fontFamily = "'DM Sans', sans-serif";
    }
  });
  return canvas.toDataURL('image/png');
}

async function doDownload() {
  const btn = document.getElementById('btn-dl');
  setBusy(btn, true);
  try {
    const dataURL = await captureCard();
    const label = capturedPhones.length > 1
      ? capturedPhones[0] + '_+' + (capturedPhones.length - 1) + 'more'
      : (capturedPhones[0] || 'code');
    const a = document.createElement('a');
    a.href = dataURL; a.download = 'QR_Naitik_' + label + '.png';
    a.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
    document.body.appendChild(a); a.click();
    setTimeout(() => document.body.removeChild(a), 1500);
    toast('📥 Downloaded!');
  } catch(e) { toast('❌ Download failed.'); }
  finally { setBusy(btn, false); }
}

async function doShare() {
  const btn = document.getElementById('btn-sh');
  setBusy(btn, true);
  try {
    const dataURL = await captureCard();
    const label = capturedPhones.length > 1
      ? capturedPhones[0] + '_+' + (capturedPhones.length - 1) + 'more'
      : (capturedPhones[0] || 'code');
    const fileName = 'QR_Naitik_' + label + '.png';
    const res = await fetch(dataURL);
    const blob = await res.blob();
    const file = new File([blob], fileName, { type: 'image/png' });

    if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ files: [file], title: 'QR Code – ' + capturedPhones.join(', '), text: 'Scan to open or connect' });
      toast('📤 Shared!'); return;
    }
    if (navigator.share) {
      const a = document.createElement('a');
      a.href = dataURL; a.download = fileName;
      a.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
      document.body.appendChild(a); a.click();
      setTimeout(() => document.body.removeChild(a), 1500);
      await navigator.share({ title: 'QR Code – ' + capturedPhones.join(', '), text: 'Scan to open or connect' });
      toast('📤 Shared!'); return;
    }
    const w = window.open();
    if (w) {
      w.document.write('<html><body style="margin:0;background:#111;display:flex;align-items:center;justify-content:center;min-height:100vh"><img src="' + dataURL + '" style="max-width:100%;border-radius:16px" /></body></html>');
      toast('🖼️ Opened in new tab');
    } else { toast('❌ Popup blocked.'); }
  } catch(e) { if (e.name !== 'AbortError') toast('❌ Share failed.'); }
  finally { setBusy(btn, false); }
}

function setBusy(btn, on) {
  btn.disabled = on;
  btn.classList.toggle('busy', on);
}

let toastT;
function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  clearTimeout(toastT);
  toastT = setTimeout(() => el.classList.remove('show'), 3200);
}
